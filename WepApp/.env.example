LLM_PROVIDER=openai
# Set the API key for your chosen provider (see dropdown in UI):
# OpenAI (GPT-4o-mini):
OPENAI_API_KEY=
# Anthropic (Claude 3 Haiku):
ANTHROPIC_API_KEY=
# Google Gemini 2.5 Flash (free): https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
# Optional: seconds to wait between Gemini API calls to avoid 429 (e.g. 1 or 2). Default 0.
# GEMINI_REQUEST_DELAY_SECONDS=2
# Groq (Llama 3.1 8B, free): https://console.groq.com
GROQ_API_KEY=
# Hugging Face (Mistral 7B, Meditron, etc.): https://huggingface.co/settings/tokens
HF_TOKEN=
# DeepSeek (deepseek-chat): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

GOLD_STANDARD_MODE=public
# Optional: path to gold standard .json or .ttl (default: resources/brainit_core_2003.ttl). Used when mode=restricted.
GOLD_STANDARD_PATH=

CORPUS_PATH=data/corpus
# Default paper for "Use default paper" toggle (relative to project root or absolute path). Example: data/corpus_ui/default_paper.txt
# DEFAULT_PAPER_PATH=

# Optional: local GGUF (Me-LLaMA etc.). Only used when model path points to a .gguf file.
# Context size; default 16384 so large prompts (e.g. LLM Reasoning Layer) fit. Increase if you see "exceed context window".
# LOCAL_GGUF_N_CTX=16384
# LOCAL_GGUF_CPU=0
# LOCAL_MAX_NEW_TOKENS=256
