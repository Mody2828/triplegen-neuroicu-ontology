{
  "_comment": "BrainIT benchmark config template. scope_filter MUST be set. Copy this file and replace llm_provider.",

  "llm_provider": "openai",
  "corpus_path": "data/corpus_ui",
  "gold_standard_path": "resources/brainit_core_2003.ttl",
  "gold_standard_mode": "restricted",

  "scope_filter": true,
  "clinical_only_routing": true,
  "require_label_in_evidence": true,

  "strategies": [
    {"name": "baseline",   "prompt_strategy": "baseline"},
    {"name": "one-shot",   "prompt_strategy": "one_shot"},
    {"name": "fewshot-1",  "prompt_strategy": "simple_fewshot"},
    {"name": "fewshot-2",  "prompt_strategy": "phased_2step"},
    {"name": "fewshot-3",  "prompt_strategy": "phased_3step"}
  ]
}
